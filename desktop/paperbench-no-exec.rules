# PaperBench 0919 batch: Code-Dev grading is static, and every arm writes without executing. Forbid running code.
# Remove this file after the batch (or keep: it only bites on these program names).
prefix_rule(pattern=["python"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["python3"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["pytest"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["uv"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["pip"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["pip3"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["conda"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["node"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["bash"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["sh"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["make"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")
prefix_rule(pattern=["docker"], decision="forbidden", justification="no code execution in the PaperBench Code-Dev batch")

# PaperBench 0919 batch (rule of 09-20 evening): quick checks are allowed, experiments are not — and a human decides per
# command. Every interpreter / installer / shell / build command is escalated to an approval prompt ("prompt"); the operator
# approves syntax/import checks, unit or smoke tests and dependency installs, and rejects training, evaluation, benchmarks
# and dataset/model downloads (README §2 step 2). desktop_prep.sh installs this file into ~/.codex/rules and removes the
# older paperbench-no-exec.rules (a "forbidden" rule would win over "prompt"). Remove after the batch.
prefix_rule(pattern=["python"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["python3"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["pytest"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["uv"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["pip"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["pip3"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["conda"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["node"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["bash"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["sh"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["make"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["docker"], decision="prompt", justification="PaperBench batch: quick checks only — the operator approves or rejects")
prefix_rule(pattern=["wget"], decision="prompt", justification="PaperBench batch: no dataset / model downloads — the operator rejects")
prefix_rule(pattern=["curl"], decision="prompt", justification="PaperBench batch: no dataset / model downloads — the operator rejects")

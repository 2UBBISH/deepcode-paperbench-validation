# secrets — keys enter only through an env file (ENV_FILE=...) or DEEPCODE_HOME/credentials.json, never the repo
.env
.env.*
!.env.example
credentials.json
*.env
# local environments / runtime state
__pycache__/
*.pyc
.venv/
deepcode_lab/
.deepcode-home/
.mcp-node/
# PaperBench (openai/frontier-evals @ patches/UPSTREAM_BASE.txt, sparse: project/paperbench + project/common) is VENDORED
# under paperbench/frontier-evals/ since 2026-09-19 (plain files, patch applied, LFS assets hydrated for the papers in use);
# only its runtime state stays out
paperbench/frontier-evals/project/paperbench/.venv/
paperbench/frontier-evals/project/paperbench/runs/
paperbench/frontier-evals/project/paperbench/run_eval.log
paperbench/frontier-evals/project/common/nanoeval/records/
*.egg-info/
# every run's logs, inputs, task-directory archives, submission copies and grades live here, never in git
paperbench/runs/
run.log
# result/codex: the desktop agents downloaded datasets and dumped features into their trees — not judged, not stored
result/codex/**/data/cifar-10*
result/codex/**/artifacts/probe/features/
*.npz

# gitignore for the generator snapshot: its venv and run state
deepevol-deepcode/generator/.venv/
deepevol-deepcode/generator/**/__pycache__/

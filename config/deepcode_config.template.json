{
  "security": { "accessPreset": "ask" },
  "providers": {
    "profiles": {
      "paratera": {
        "label": "Paratera",
        "template": "custom",
        "protocol": "openai_chat",
        "auth": "api_key",
        "compat": { "thinking": "disabled" },
        "apiBase": "https://llmapi.paratera.com/v1",
        "apiKeyEnv": "PARATERA_API_KEY",
        "extraHeaders": {},
        "modelCatalog": "manual",
        "manualModels": [
          { "id": "DeepSeek-V4-Flash", "contextWindow": 128000, "maxOutputTokens": 32768 },
          { "id": "DeepSeek-V4-Flash-Vision-Exp", "contextWindow": 128000, "maxOutputTokens": 32768 }
        ],
        "enabled": true
      },
      "deepseek": {
        "label": "DeepSeek (official)",
        "template": "custom",
        "protocol": "openai_chat",
        "auth": "api_key",
        "compat": { "thinking": "enabled" },
        "apiBase": "https://api.deepseek.com/v1",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "extraHeaders": {},
        "modelCatalog": "manual",
        "manualModels": [
          { "id": "deepseek-flash", "contextWindow": 1000000, "maxOutputTokens": 32768 }
        ],
        "enabled": true
      }
    }
  },
  "agents": {
    "defaults": {
      "connection": "__CONNECTION__",
      "model": "__MODEL__",
      "temperature": 0.1,
      "maxTokens": 32768
    },
    "planning": {},
    "implementation": {}
  },
  "tools": {
    "defaultSearchServer": "filesystem",
    "mcpServers": {
      "code-implementation":    { "type": "stdio", "command": "__PY__",  "args": ["-m", "tools.code_implementation_server"], "tool_timeout": 600 },
      "code-reference-indexer": { "type": "stdio", "command": "__PY__",  "args": ["-m", "tools.code_reference_indexer"],    "tool_timeout": 300 },
      "document-segmentation":  { "type": "stdio", "command": "__PY__",  "args": ["-m", "tools.document_segmentation_server"], "tool_timeout": 300 },
      "filesystem":             { "type": "stdio", "command": "__NODE__", "args": ["__FS_JS__", "__WORKSPACE__"], "tool_timeout": 300 },
      "fetch":                  { "type": "stdio", "command": "__FETCH__", "args": [], "tool_timeout": 300 },
      "github-downloader":      { "type": "stdio", "command": "__PY__",  "args": ["-m", "tools.git_command"],      "tool_timeout": 600 },
      "command-executor":       { "type": "stdio", "command": "__PY__",  "args": ["-m", "tools.command_executor"], "tool_timeout": 600 }
    }
  }
}

complete_reproduction_plan:
  paper_info:
    title: "RICE: Breaking Through the Training Bottlenecks of Reinforcement Learning with Explanation"
    core_contribution: "A refining scheme that (1) trains a simplified StateMask-style mask network to identify critical states, (2) resets the agent from a mixed initial distribution of default initial states and critical states, and (3) continues PPO training with a Random Network Distillation (RND) exploration bonus to break local optima."

  file_structure: |
    rice/

    │   ├── __init__.py
    │   ├── mask_network.py          # Mask-net policy + Algorithm 1 training loop
    │   ├── mixed_reset_env.py       # Gym wrapper for mixed initial-state resets
    │   ├── rnd_module.py            # RND target/predictor networks + normalization
    │   ├── refine_agent.py          # Algorithm 2: RICE refining loop

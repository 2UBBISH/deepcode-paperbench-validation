complete_reproduction_plan:
  paper_info:
    title: "RICE: Refining with Importance-based Critical state Exploration"
    core_contribution: "A framework that combines explanation-based identification of critical states with a mixed initial state distribution and exploration bonuses to refine deep reinforcement learning agents, overcoming training bottlenecks."

  file_structure: |
    project_root/
    ├── README.md                          # Documentation (implement LAST)

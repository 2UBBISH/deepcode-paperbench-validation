complete_reproduction_plan:
  paper_info:
    title: "RICE: Refining Reinforcement Learning Agents via Critical Explanations"
    core_contribution: >
      A unified framework that (1) trains a lightweight mask network to identify
      critical decision steps of a pre-trained RL agent, and (2) refines the
      agent by restarting episodes from a mixed initial-state distribution
      (default initial states plus sampled critical states) while adding an
      RND-based exploration bonus. The method is evaluated on dense/sparse
      MuJoCo, selfish mining, CAGE Challenge 2 cyber defense, MetaDrive
      autonomous driving, and malware mutation.

  file_structure: |
    rice/
    ├── rice/
    │   ├── __init__.py
    │   ├── agents/
    │   │   ├── target_agent.py          # PPO/SAC target policy training wrappers
    │   │   ├── mask_network.py          # MaskNet + perturbed-policy explanation
    │   │   └── rnd_network.py           # Random Network Distillation bonus
    │   ├── envs/
    │   │   ├── resettable_env.py        # Wrapper to reset to stored critical states
    │   │   ├── mujoco_wrappers.py       # Dense/sparse reward wrappers, obs norm
    │   │   ├── selfish_mining_env.py    # Adapter for pto-selfish-mining repo
    │   │   ├── cage_env.py              # Adapter for CybORG/CAGE Challenge 2
    │   │   ├── metadrive_env.py         # Adapter for MetaDrive Macro-v1
    │   │   └── malware_env.py           # Adapter for malware_rl MalConv gym
    │   ├── training/
    │   │   ├── train_target.py          # Train target agents per domain
    │   │   ├── train_mask.py            # Train MaskNet with intrinsic reward
    │   │   └── refine_agent.py          # RICE refining loop
    │   ├── evaluation/
    │   │   ├── fidelity.py              # Fidelity score computation
    │   │   ├── efficiency.py            # Wall-clock training-time benchmark
    │   │   ├── evaluate_policy.py       # Standardized evaluation rollouts
    │   │   └── visualize.py             # Trajectory/importance heatmaps
    │   └── utils/
    │       ├── config.py                # Hyper-parameter tables per domain
    │       ├── logger.py                # TensorBoard / CSV logging
    │       └── replay_buffer.py         # Trajectory and critical-state storage
    ├── scripts/
    │   ├── run_exp_i_fidelity.py        # Explanations vs StateMask / random
    │   ├── run_exp_ii_efficiency.py     # MaskNet training time comparison
    │   ├── run_exp_iii_refining.py      # Main refining results (Table 5/6)
    │   ├── run_exp_iv_sparse.py         # Sparse MuJoCo refining
    │   └── run_exp_v_case_study.py      # Malware & autonomous-driving cases
    ├── configs/
    │   ├── mujoco.yaml

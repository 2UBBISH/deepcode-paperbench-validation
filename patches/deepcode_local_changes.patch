+def _denied_urls() -> list[str]:
+    """URL substrings the agent must not retrieve, from ``DEEPCODE_URL_DENYLIST``.
+
+    [local compat][fre] The DeepCode paper (arXiv:2512.07921 §4.1) states that
+    "a source code blacklist is enforced during execution … precludes access to
+    the authors' original repositories … during web browsing", but the released
+    code contains no blacklist logic at all (repo-wide grep for 'blacklist' is
+    empty). Our git ``insteadOf`` block only covers the git protocol, so the
+    reference-mining agent reached the target paper's official repository over
+    plain HTTP through the fetch MCP server (observed 2026-08-26, fre trial 1).
+    The runner supplies the benchmark's own blacklist.txt through this env var,
+    which restores the protocol the paper describes rather than adding to it.
+    """
+    raw = os.environ.get("DEEPCODE_URL_DENYLIST", "")
+    return [p.strip().lower() for p in re.split(r"[,\n]", raw) if p.strip()]
+
+
+def _url_like_values(kwargs: dict[str, Any]) -> list[str]:
+    """Every string argument that could carry a URL."""
+    out: list[str] = []
+    for value in kwargs.values():
+        if isinstance(value, str):
+            out.append(value)
+        elif isinstance(value, (list, tuple)):
+            out.extend(v for v in value if isinstance(v, str))
+    return out
+
+
+# Per-process fetch ledger: (tool, url) -> times served. Guards against the
+# observed failure mode where a model re-requests the same dead URL until its
+# iteration budget is gone (fre trial 1: three nonexistent repos fetched 16x
+# each, burning 48 of 40 allowed iterations).
+_FETCH_COUNTS: dict[tuple[str, str], int] = {}
+_MAX_SAME_URL_FETCHES = 2
+
+
+def _sanitize_exposed_name(name: str) -> str:
+    """Make a model-facing tool name safe for constrained tool-call decoding.
+
+    [local compat][E1] Hyphens are legal per the OpenAI function-name spec,
+    but siliconflow's Kimi-K2.7 endpoint silently fails to emit a structured
+    tool call for any declared name containing '-' (A/B verified 2026-08-26:
+    'mcp_github-downloader_git_clone' -> finish='stop' with zero tool_calls;
+    the same schema as 'mcp_github_downloader_git_clone' -> a correct call).
+    Server names like 'github-downloader' / 'document-segmentation' therefore
+    produced silently dead tools. Routing is unaffected: wrappers call the
+    MCP server via ``_original_name`` + session, never via the exposed name.
+    """
+    return name.replace("-", "_")
+

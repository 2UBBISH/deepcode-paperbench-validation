{
  "method": "fare",
  "arch": "ViT-L-14",
  "pretrained": "openai",
  "image_size": 224,
  "eps": "2/255",
  "pgd_alpha": "1/255",
  "pgd_steps": 10,
  "pgd_momentum": 0.9,
  "pgd_grad_norm": "elementwise_sign",
  "pgd_random_init": true,
  "feature": "projected_class_token",
  "epochs": 2,
  "batch_size": 128,
  "lr": 1e-05,
  "weight_decay": 0.0001,
  "beta1": 0.9,
  "beta2": 0.95,
  "warmup_frac": 0.07,
  "lr_schedule": "cosine",
  "imagenet_prompt": "A photo of a {}.",
  "_comment": "FARE^2-CLIP of the paper: unsupervised adversarial fine-tuning of ViT-L/14 at eps=2/255 (Sec. 4, App. B.1)"
}
